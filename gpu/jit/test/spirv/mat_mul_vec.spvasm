     OpEntryPoint GLCompute %main "main"
     OpExecutionMode %main LocalSize 1 1 1

%float = OpTypeFloat 32
%v4float = OpTypeVector %float 4
%mat44 = OpTypeMatrix %v4float 4

%f0 = OpConstant %float 0.0
%f1 = OpConstant %float 1.0
%f10 = OpConstant %float 10.0

%col0 = OpCompositeConstruct %v4float %f1 %f0 %f0 %f0
%col1 = OpCompositeConstruct %v4float %f0 %f1 %f0 %f0
%col2 = OpCompositeConstruct %v4float %f0 %f0 %f1 %f0
%col3 = OpCompositeConstruct %v4float %f0 %f10 %f0 %f1

%mvp = OpCompositeConstruct %mat44 %col0 %col1 %col2 %col3

%v_in = OpCompositeConstruct %v4float %f1 %f1 %f1 %f1

%void = OpTypeVoid
%fn_type = OpTypeFunction %float

%main = OpFunction %float None %fn_type
%label = OpLabel

%res_v = OpMatrixTimesVector %v4float %mvp %v_in

%res_y = OpCompositeExtract %float %res_v 1

    OpReturnValue %res_y
    OpFunctionEnd

