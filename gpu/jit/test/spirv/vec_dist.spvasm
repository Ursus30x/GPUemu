OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
     OpMemoryModel Logical GLSL450
     OpEntryPoint GLCompute %main "main"
     OpExecutionMode %main LocalSize 1 1 1

%void    = OpTypeVoid
%float   = OpTypeFloat 32
%v4float = OpTypeVector %float 4

%f1 = OpConstant %float 1.0
%f2 = OpConstant %float 2.0
%f3 = OpConstant %float 3.0
%f4 = OpConstant %float 4.0

%f4b = OpConstant %float 4.0
%f3b = OpConstant %float 3.0
%f2b = OpConstant %float 2.0
%f1b = OpConstant %float 1.0

%ft = OpTypeFunction %float

%main = OpFunction %float None %ft
%label = OpLabel

%vA = OpCompositeConstruct %v4float %f1 %f2 %f3 %f4

%vB = OpCompositeConstruct %v4float %f4b %f3b %f2b %f1b

%dist = OpExtInst %float %1 Distance %vA %vB

OpReturnValue %dist
OpFunctionEnd