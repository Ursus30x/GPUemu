OpCapability Shader
OpMemoryModel Logical GLSL450

OpEntryPoint GLCompute %f "main"
OpExecutionMode %f LocalSize 1 1 1

%void = OpTypeVoid
%float = OpTypeFloat 32
%v4float = OpTypeVector %float 4

%const1 = OpConstant %float 1.0
%const2 = OpConstant %float 2.0
%const3 = OpConstant %float 3.0
%const4 = OpConstant %float 4.0

%ft = OpTypeFunction %float

%f = OpFunction %float None %ft
%label = OpLabel

; vec4(1,2,3,4)
%v = OpCompositeConstruct %v4float %const1 %const2 %const3 %const4

; extract v[2]
%elem = OpCompositeExtract %float %v 2

OpReturnValue %elem
OpFunctionEnd