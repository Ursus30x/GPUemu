; SPIR-V
; Version: 1.0
      OpCapability Shader
      OpMemoryModel Logical GLSL450
      OpEntryPoint GLCompute %f "main" 
      OpExecutionMode %f LocalSize 1 1 1
      
      %void = OpTypeVoid
      %float = OpTypeFloat 32
      %_ptr_Private_float = OpTypePointer Private %float
      
      %const_2 = OpConstant %float 2.0
      %const_3 = OpConstant %float 3.0
      %const_1_5 = OpConstant %float 1.5

      %ft = OpTypeFunction %float
      %f = OpFunction %float None %ft
      %label = OpLabel

      %f1 = OpVariable %_ptr_Private_float Private %const_2
      %f2 = OpVariable %_ptr_Private_float Private %const_3
      %f3 = OpVariable %_ptr_Private_float Private %const_1_5
      
      %val1 = OpLoad %float %f1
      %val2 = OpLoad %float %f2
      %val3 = OpLoad %float %f3
      
      ; Multiplication: (2.0 * 3.0) * 1.5
      %mul_result = OpFMul %float %val1 %val2
      %mul_result2 = OpFMul %float %mul_result %val3
      
      OpReturnValue %mul_result2
      OpFunctionEnd 
