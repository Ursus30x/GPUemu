OpCapability Shader
%1 =  OpExtInstImport "GLSL.std.450"
      OpMemoryModel Logical GLSL450
      OpEntryPoint GLCompute %main "main"
      OpExecutionMode %main LocalSize 1 1 1

%void    = OpTypeVoid
%float   = OpTypeFloat 32
%v4float = OpTypeVector %float 4

%c1 = OpConstant %float 1.0
%c2 = OpConstant %float 2.0
%c3 = OpConstant %float 3.0
%c4 = OpConstant %float 4.0

%ft = OpTypeFunction %float

%main = OpFunction %float None %ft
%label = OpLabel

%v = OpCompositeConstruct %v4float %c1 %c2 %c3 %c4

%norm_v = OpExtInst %v4float %1 Normalize %v

%res_x = OpCompositeExtract %float %norm_v 0

OpReturnValue %res_x
OpFunctionEnd