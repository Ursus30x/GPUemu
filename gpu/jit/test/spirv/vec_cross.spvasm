OpCapability Shader
%1 =  OpExtInstImport "GLSL.std.450"
      OpMemoryModel Logical GLSL450
      OpEntryPoint GLCompute %main "main"
      OpExecutionMode %main LocalSize 1 1 1

%void    = OpTypeVoid
%float   = OpTypeFloat 32
%v3float = OpTypeVector %float 3

%f0 = OpConstant %float 0.0
%f1 = OpConstant %float 1.0

%ft = OpTypeFunction %float

%main = OpFunction %float None %ft
%label = OpLabel

%vX = OpCompositeConstruct %v3float %f1 %f0 %f0
%vY = OpCompositeConstruct %v3float %f0 %f1 %f0

%vRes = OpExtInst %v3float %1 Cross %vX %vY

%z_val = OpCompositeExtract %float %vRes 2

OpReturnValue %z_val
OpFunctionEnd